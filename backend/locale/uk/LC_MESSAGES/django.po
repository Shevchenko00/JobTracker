#: apps/jobs/models/job_applications.py:10
msgid "Das Bewerbungsdatum darf nicht in der Zukunft liegen."
msgstr "Дата подання заявки не може бути в майбутньому."

#: apps/jobs/models/job_applications.py:22
msgid "Ausstehend"
msgstr "Очікує"

#: apps/jobs/models/job_applications.py:23
msgid "Angenommen"
msgstr "Прийнято"

#: apps/jobs/models/job_applications.py:24
msgid "Abgelehnt"
msgstr "Відхилено"

#: apps/jobs/models/job_applications.py:29
msgid "Firmenname"
msgstr "Назва компанії"

#: apps/jobs/models/job_applications.py:30
msgid "Name des Unternehmens, bei dem du dich beworben hast."
msgstr "Назва компанії, до якої ви подали заявку."

#: apps/jobs/models/job_applications.py:32
msgid "Bitte gib den Firmennamen ein."
msgstr "Будь ласка, вкажіть назву компанії."

#: apps/jobs/models/job_applications.py:33
msgid "Der Firmenname darf maximal 255 Zeichen lang sein."
msgstr "Назва компанії не може перевищувати 255 символів."

#: apps/jobs/models/job_applications.py:37
msgid "Beschreibung"
msgstr "Опис"

#: apps/jobs/models/job_applications.py:38
msgid "Beschreibung der Position oder Bewerbung."
msgstr "Опис позиції або заявки."

#: apps/jobs/models/job_applications.py:40
msgid "Bitte gib eine Beschreibung ein."
msgstr "Будь ласка, введіть опис."

#: apps/jobs/models/job_applications.py:46
msgid "Link zur Stellenanzeige"
msgstr "Посилання на вакансію"

#: apps/jobs/models/job_applications.py:47
msgid "Optionaler Link zur Stellenausschreibung."
msgstr "Необов'язкове посилання на оголошення про вакансію."

#: apps/jobs/models/job_applications.py:52
msgid "Notizen"
msgstr "Нотатки"

#: apps/jobs/models/job_applications.py:53
msgid "Optionale persönliche Notizen zur Bewerbung."
msgstr "Необов'язкові особисті нотатки щодо заявки."

#: apps/jobs/models/job_applications.py:59
msgid "Status"
msgstr "Статус"

#: apps/jobs/models/job_applications.py:60
msgid "Aktueller Stand der Bewerbung."
msgstr "Поточний стан заявки."

#: apps/jobs/models/job_applications.py:62
msgid "Ungültiger Status ausgewählt."
msgstr "Обрано недійсний статус."

#: apps/jobs/models/job_applications.py:68
msgid "Bewerbungsdatum"
msgstr "Дата подання заявки"

#: apps/jobs/models/job_applications.py:69
msgid "Datum, an dem die Bewerbung abgeschickt wurde."
msgstr "Дата, коли заявку було подано."

#: apps/jobs/models/job_applications.py:72
msgid "Bitte gib ein gültiges Datum ein (Format: JJJJ-MM-TT)."
msgstr "Будь ласка, введіть дійсну дату (формат: РРРР-ММ-ДД)."

#: apps/jobs/models/job_applications.py:78
msgid "Bewerbung"
msgstr "Заявка"

#: apps/jobs/models/job_applications.py:79
msgid "Bewerbungen"
msgstr "Заявки"

#: apps/jobs/views/jobs_applications_view.py:56
#, python-format
msgid "Ungültiger Status: %(values)s. Erlaubt sind: %(allowed)s."
msgstr "Недійсний статус: %(values)s. Дозволені значення: %(allowed)s."

#: apps/jobs/views/jobs_applications_view.py:89
msgid "Ungültiges Datumsformat. Bitte JJJJ-MM-TT verwenden (z. B. 2026-01-31)."
msgstr "Невірний формат дати. Використовуйте формат РРРР-ММ-ДД (наприклад, 2026-01-31)."

#: apps/jobs/views/jobs_applications_view.py
msgid "Für dieses Unternehmen existiert bereits eine Bewerbung mit diesem Datum."
msgstr "Для цієї компанії вже існує заявка з цією датою."
